   "source": [
    "## 3. When did ChatGPT overtake Google Translate?\n",
    "\n",
    "Find the first month where ChatGPT's search interest exceeds Google Translate's."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-02T15:01:19.909583Z",
     "iopub.status.busy": "2026-08-02T15:01:19.909228Z",
     "iopub.status.idle": "2026-08-02T15:01:19.921844Z",
     "shell.execute_reply": "2026-08-02T15:01:19.921131Z",
     "shell.execute_reply.started": "2026-08-02T15:01:19.909559Z"
    },
    "trusted": true
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Crossover month: February 2024\n",
      "     Month  Google Translate  ChatGPT\n",
      "2024-02-01                24       27\n"
     ]
    }
   ],
   "source": [
    "crossover = monthly[monthly[\"ChatGPT\"] > monthly[\"Google Translate\"]].sort_values(\"Month\").head(1)\n",
    "if not crossover.empty:\n",
    "    date = crossover[\"Month\"].dt.strftime(\"%B %Y\").values[0]\n",
    "    print(f\"Crossover month: {date}\")\n",
    "    print(crossover[[\"Month\", \"Google Translate\", \"ChatGPT\"]].to_string(index=False))\n",
    "else:\n",
    "    print(\"No crossover found in this window.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Segmented trend: did Google Translate's trajectory change after ChatGPT launched?\n",
    "\n",
    "Fit separate linear trends to Google Translate's monthly search interest before and after November 2022."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-02T15:01:24.692598Z",
     "iopub.status.busy": "2026-08-02T15:01:24.692357Z",
     "iopub.status.idle": "2026-08-02T15:01:24.719856Z",
     "shell.execute_reply": "2026-08-02T15:01:24.719173Z",
     "shell.execute_reply.started": "2026-08-02T15:01:24.692579Z"
    },
    "trusted": true
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "pre_chatgpt: growing at 0.129 index points/month (n=83 months)\n",
      "post_chatgpt: declining at -0.396 index points/month (n=44 months)\n"
     ]
    }
   ],
   "source": [
    "def segmented_trend(df, col, cutoff=CHATGPT_LAUNCH):\n",
    "    df = df.sort_values(\"Month\").reset_index(drop=True)\n",
    "    df[\"t\"] = np.arange(len(df))\n",
    "    pre = df[df[\"Month\"] < cutoff]\n",
    "    post = df[df[\"Month\"] >= cutoff]\n",
    "\n",
    "    results = {}\n",
    "    for label, seg in [(\"pre_chatgpt\", pre), (\"post_chatgpt\", post)]:\n",
    "        slope, intercept = np.polyfit(seg[\"t\"], seg[col], 1)\n",
    "        results[label] = {\"slope_per_month\": round(slope, 3), \"n_months\": len(seg)}\n",
    "    return results\n",
    "\n",
    "gt_trend = segmented_trend(monthly, \"Google Translate\")\n",
    "for period, stats in gt_trend.items():\n",
    "    direction = \"declining\" if stats[\"slope_per_month\"] < 0 else \"growing\"\n",
    "    print(f\"{period}: {direction} at {stats['slope_per_month']} index points/month (n={stats['n_months']} months)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Cross-correlation: does ChatGPT's rise predict Google Translate's decline?\n",
    "\n",
    "Normalize both series (z-score) and test correlation across a ±6 month lag window."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-02T15:01:28.084429Z",
     "iopub.status.busy": "2026-08-02T15:01:28.084136Z",
     "iopub.status.idle": "2026-08-02T15:01:28.397061Z",
     "shell.execute_reply": "2026-08-02T15:01:28.396522Z",
     "shell.execute_reply.started": "2026-08-02T15:01:28.084407Z"
    },
    "trusted": true
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Strongest (most negative) correlation: r = -0.648 at lag 6 months\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x400 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "def zscore(s):\n",
    "    return (s - s.mean()) / s.std()\n",
    "\n",
    "m = monthly.copy()\n",
    "m[\"gt_z\"] = zscore(m[\"Google Translate\"])\n",
    "m[\"chatgpt_z\"] = zscore(m[\"ChatGPT\"])\n",
    "\n",
    "max_lag = 6\n",
    "lags = range(-max_lag, max_lag + 1)\n",
    "corrs = [m[\"gt_z\"].corr(m[\"chatgpt_z\"].shift(lag)) for lag in lags]\n",
    "xcorr = pd.DataFrame({\"lag_months\": list(lags), \"correlation\": corrs})\n",
    "\n",
    "best = xcorr.loc[xcorr[\"correlation\"].idxmin()]\n",
    "print(f\"Strongest (most negative) correlation: r = {best['correlation']:.3f} at lag {int(best['lag_months'])} months\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 4))\n",
    "ax.bar(xcorr[\"lag_months\"], xcorr[\"correlation\"], color=\"#3F8C79\")\n",
    "ax.axhline(0, color=\"black\", linewidth=0.8)\n",
    "ax.set_xlabel(\"Lag (months) — negative = ChatGPT leads\")\n",
    "ax.set_ylabel(\"Correlation\")\n",
    "ax.set_title(\"Time-lagged cross-correlation: ChatGPT vs. Google Translate\", fontsize=12, weight=\"bold\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"cross_correlation.png\", dpi=150)\n",
    "plt.show()"
   ]
  },
  {
